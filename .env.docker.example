# ─────────────────────────────────────────────────────────────────────────────
# Dharma Seekho — Docker environment
# Copy to .env.docker and fill in real values before running.
# The JWT tokens below are PRE-GENERATED for local development only.
# Generate your own for staging/production: https://supabase.com/docs/guides/self-hosting/docker#generate-api-keys
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL superuser password (used for all Supabase internal service users)
POSTGRES_PASSWORD=postgres-local-dev-change-in-prod

# JWT secret — must be at least 32 characters
JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long

# Pre-generated dev tokens matching the JWT_SECRET above.
# REPLACE BOTH for any non-local environment.
ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRFA0NiK7W9oaVAjb1PrmRBwMzl9p1tMfKbqZR7ks1Y
SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hj04zWl196z2-SBc0

# SMS OTP — leave as "test" for local dev (OTP appears in `docker compose logs auth`)
# Switch to "twilio" and fill the three vars below for real phone auth
SMS_PROVIDER=test
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGE_SERVICE_SID=

# Google TTS service account JSON (single-line, escaped) — needed for audio generation
GOOGLE_SERVICE_ACCOUNT_JSON=

# Razorpay webhook secret — needed for payment events
RAZORPAY_WEBHOOK_SECRET=
